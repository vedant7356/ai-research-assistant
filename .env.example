# Copy to .env and fill in. Never commit .env.

# PostgreSQL (local). Defaults work with Homebrew Postgres; only uncomment+fill to override.
# (A blank value overrides the default with an empty string, so leave unused lines commented out.)
# DB_URL=jdbc:postgresql://localhost:5432/research_assistant
# DB_USERNAME=
# DB_PASSWORD=

# LLM provider (Purdue GenAI Studio) - filled in at Checkpoint 5
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# OpenAlex (optional free key; raises daily search budget). Get one at https://openalex.org/settings/api
OPENALEX_API_KEY=
